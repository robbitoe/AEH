# Example image for AEH agents (sandbox, stage 6). It must hold the program of every
# profile your configuration launches, the tools those agents call while they work
# (the gate image's tools are a good start), and aeh-egress, which gives agents their
# declared hosts and nothing else. Agents run as user 10001 with a read-only root
# filesystem and no network; /tmp and HOME are writable, and HOME starts empty or with
# the profile's saved session files. Pin the CLI versions you use.
#
# Build it from the root of the AEH repository (aeh-egress is compiled from its source),
# at the release that matches your aeh:
#
#   docker build -t myproject-agents -f docs/sandbox/Dockerfile.agents \
#     --build-arg CODEX_VERSION=<version> --build-arg CLAUDE_CODE_VERSION=<version> .
#   docker image inspect -f '{{.Id}}' myproject-agents    # put this ID in sandbox.agent_image
#
# Then list each profile's hosts in sandbox.egress and sign in once per profile that
# uses a session: aeh sandbox login <profile>
FROM golang:1.24-bookworm AS egress
WORKDIR /src
COPY go.mod go.sum ./
COPY internal/egress ./internal/egress
COPY cmd/aeh-egress ./cmd/aeh-egress
RUN CGO_ENABLED=0 go build -trimpath -o /aeh-egress ./cmd/aeh-egress

FROM node:22-bookworm-slim

ARG CODEX_VERSION
ARG CLAUDE_CODE_VERSION
RUN test -n "$CODEX_VERSION" && test -n "$CLAUDE_CODE_VERSION" \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g --ignore-scripts=false \
      "@openai/codex@${CODEX_VERSION}" \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
 && npm cache clean --force

COPY --from=egress /aeh-egress /usr/local/bin/aeh-egress

ENV npm_config_cache=/tmp/npm-cache \
    npm_config_update_notifier=false \
    DISABLE_AUTOUPDATER=1
