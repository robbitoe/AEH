# Example image for AEH gate commands (sandbox, stage 6). It must hold every tool your
# build, test and acceptance commands call, and every dependency they need: gates run
# with no network. Adapt it to your stack.
#
#   docker build -t myproject-gates -f Dockerfile.tools .
#   docker image inspect -f '{{.Id}}' myproject-gates    # put this ID in sandbox.image
#
# Rebuild the image, and update sandbox.image, whenever the dependencies change.
FROM node:22-alpine

# Dependencies live outside /work: aeh mounts the exported commit there.
WORKDIR /opt/deps
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && chmod -R a+rX /opt/deps

# Gates run as user 10001 with a read-only root filesystem; /tmp and HOME are writable.
ENV NODE_PATH=/opt/deps/node_modules \
    PATH=/opt/deps/node_modules/.bin:$PATH \
    npm_config_cache=/tmp/npm-cache \
    npm_config_update_notifier=false
